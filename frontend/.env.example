# QA Training Platform - Environment Variables
# Copy to .env and set values. For production build, pass these at build time.

# Backend API URL (required for production; leave empty for demo mode)
# Local: http://localhost:8080
# Fly.io: https://qa-platform-backend.fly.dev
VITE_API_URL=

# Demo mode: use mock data instead of backend (true = demo, false = use VITE_API_URL)
VITE_DEMO_MODE=true

# Optional: Analytics
# VITE_ANALYTICS_ID=
